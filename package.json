{
  "name": "dsh-model-fingerprint",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "模型指纹检测：在这台 DSH 已接入的模型里挑一个，让它随手写下约 300 个整数，与内置的模型参考库比对，判断它到底是哪家的模型。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "data/bundle.json",
    "data/shared_detector.bin",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "fingerprint",
    "llm-detection"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "meta": {
      "title": "模型指纹",
      "description": "在侧边栏「自动化任务」下方打开模型指纹面板，从这台 DSH 已接入的模型里手选一个，让它凭第一反应写下约 300 个 1 到 355 的整数，再与内置的模型参考库比对，判断它到底是哪家的模型。取样走宿主的 llm 服务，不需要填地址和密钥，作业跑在宿主进程里，关掉页面也会继续。"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5"
    }
  },
  "license": "MIT"
}
